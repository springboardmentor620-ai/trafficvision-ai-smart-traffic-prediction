# The frontend calls the backend through /api/* (see next.config.js rewrites),
# so no public API URL needs to be exposed to the browser by default.
# Add variables here only if you need to reference the backend URL directly
# in client code later, e.g.:
# NEXT_PUBLIC_API_URL=http://localhost:8000
#NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE