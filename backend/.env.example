# Database Connection
DATABASE_URL=postgresql+psycopg://trafficvision:trafficvision_password@localhost:5432/trafficvision_db

# Security & JWT
SECRET_KEY=change-this-secret-key-before-final-submission
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Telemetry Simulator Settings
SIMULATOR_INTERVAL_SECONDS=5

# SMTP Email Notification Dispatch (Optional - leave empty for simulated local logs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@trafficvision.ai
SMTP_USE_TLS=true
ALERT_DISPATCH_EMAILS=admin@trafficvision.ai,ops@trafficvision.ai
