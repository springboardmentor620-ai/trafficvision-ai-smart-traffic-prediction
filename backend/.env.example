# Optional SMTP configuration for login-triggered traffic alert emails.
# Use an app password when your mail provider requires one. Never commit .env.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=replace-with-your-app-password
MAIL_FROM=your-email@example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Optional PostgreSQL configuration. Leave DATABASE_PASSWORD unset to use the
# application's local demo-authentication fallback when PostgreSQL is unavailable.
DATABASE_HOST=localhost
DATABASE_NAME=trafficvision_db
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-your-database-password
DATABASE_PORT=5432
