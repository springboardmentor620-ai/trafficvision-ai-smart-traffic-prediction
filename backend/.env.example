# Environment Configuration
ENVIRONMENT=development
PORT=8000
SECRET_KEY=supersecret-trafficvision-key-change-in-production

# CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Relational Database / Supabase PostgreSQL Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trafficvision_db
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# AI / Video Processing Settings
YOLO_MODEL_PATH=models/yolov8n.pt
UPLOAD_FOLDER=uploads/videos
OUTPUT_FOLDER=uploads/processed

# Document / Telemetry Database MongoDB Connection URL
MONGODB_URL=mongodb://localhost:27017/trafficvision_logs
MONGODB_DB_NAME=trafficvision_logs
MONGODB_URI=mongodb://localhost:27017/trafficvision_logs
